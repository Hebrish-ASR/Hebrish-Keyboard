# Thin-fork settings. Sourced by the scripts and workflows (bash) and read line by line by the
# Gradle block (KEY=value; quotes stripped). Keep one KEY=value per line, no `export`.

# The upstream project and which of its tags count as stable releases (extended regex).
UPSTREAM_URL=https://github.com/HeliBorg/HeliBoard.git
UPSTREAM_TAG_REGEX='^v[0-9]+(\.[0-9]+)*$'

# Version suffix and revision. Each APK is <upstream versionName>-<SUFFIX>.<REVISION>, tag
# v<upstream versionName>-<SUFFIX>.<REVISION>, versionCode upstream * 100 + REVISION.
# Bump REVISION for a release of your own changes; the sync workflow resets it to 1.
SUFFIX=hebrish
REVISION=1

# Where upstream keeps its versionName (first `versionName = "..."` in this file).
VERSION_FILE=app/build.gradle.kts

# Build.
JAVA_VERSION=17
BUILD_TASK=assembleRelease
APK_GLOB='app/build/outputs/apk/release/*-release.apk'

# Release naming. APK file: <APK_NAME>-v<version>.apk.
APK_NAME=HebrishKeyboard
RELEASE_TITLE='Hebrish Keyboard'
